rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for document ID validation
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Contributor user accounts - store login info, author profiles, links
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if false;
    }

    // Packages registry: links, manifest, versions, and READMEs
    match /packages/{packageId} {
      allow read: if true;
      allow create, update: if isValidId(packageId);
      allow delete: if false;
    }

    // Registry stats and download metrics
    match /registry_stats/{statId} {
      allow read: if true;
      allow write: if isValidId(statId);
    }
  }
}
