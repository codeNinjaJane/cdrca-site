rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Contributor user accounts - store login info, author profiles, links
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true; // Allow client sync on login and updates
      allow delete: if isAuthenticated();
    }

    // Packages registry: links, manifest, versions, and READMEs
    match /packages/{packageId} {
      allow read: if true;
      allow write: if true; // Allows contributors to publish and update documentation/links
    }

    // Registry stats and download metrics
    match /registry_stats/{statId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
